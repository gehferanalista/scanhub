# URL base da API do Scanhub (relativa usa o proxy do Vite)
VITE_API_URL=/api
# Liga os mocks do MSW em desenvolvimento (simula o ERP enquanto não há back-end)
VITE_ENABLE_MOCKS=true
# Destino do proxy /api no `pnpm dev`. Para usar a API local (apps/api), desligue os mocks
# acima e use http://localhost:3333
API_PROXY_TARGET=

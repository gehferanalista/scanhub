# Ambiente: development | test | production
NODE_ENV=development
# Endereço e porta em que a API escuta
HOST=0.0.0.0
PORT=3333
# Nível de log: fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# Banco do Scanhub. Em desenvolvimento, o Postgres do docker-compose.dev.yml (pnpm db:up)
DATABASE_URL=postgresql://scanhub:scanhub@localhost:5432/scanhub
# Banco usado pelos testes de integração. É APAGADO E RECRIADO a cada execução dos testes
TEST_DATABASE_URL=postgresql://scanhub:scanhub@localhost:5432/scanhub_test

{
  "name": "scanhub",
  "private": true,
  "packageManager": "pnpm@11.1.3",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:up": "docker compose -f docker-compose.dev.yml up -d --wait",
    "db:down": "docker compose -f docker-compose.dev.yml down",
    "db:reset": "docker compose -f docker-compose.dev.yml down -v && docker compose -f docker-compose.dev.yml up -d --wait",
    "db:logs": "docker compose -f docker-compose.dev.yml logs -f postgres",
    "db:psql": "docker compose -f docker-compose.dev.yml exec postgres psql -U scanhub -d scanhub",
    "db:migrate": "pnpm --filter @scanhub/api db:migrate",
    "db:generate": "pnpm --filter @scanhub/api db:generate"
  },
  "devDependencies": {
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "turbo": "^2.11.10",
    "typescript": "catalog:"
  }
}
